[Unit]
Description=dfn2 LavaSR model daemon (keeps model warm)
After=network.target sound.target

[Service]
Type=simple
User=PLACEHOLDER
ExecStart=/home/PLACEHOLDER/dfn-prototype/bin/python -u /home/PLACEHOLDER/dfn-prototype/dfn2d.py
Restart=always
RestartSec=3
Nice=10

[Install]
WantedBy=multi-user.target